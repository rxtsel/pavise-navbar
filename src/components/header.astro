---
import Burger from "@/components/burger.astro";
import Logo from "@/components/logo.astro";
import NavMobile from "@/components/nav-mobile.astro";
import Nav1 from "@/components/nav-1.astro";
import Nav2 from "@/components/nav-2.astro";
---

<header class="fixed inset-x-0 top-0 z-[99999999999999999999999999999]">
  <div
    class="mx-auto grid max-w-[1600px] grid-cols-3 items-center bg-black px-[15px] py-[15px] lg:px-10 lg:py-5"
  >
    <Burger />
    <Nav1 />
    <Logo />
    <Nav2 />
  </div>

  <NavMobile />
</header>

<style is:global>
  .nav-item-hover-border {
    background-image: linear-gradient(to bottom, transparent 20%, #fff 21%);
    background-position: 50% 1.3rem;
    background-size: 0 2px;
    background-repeat: no-repeat;
    transition: background-size 0.3s;
    padding-bottom: 5px;

    &:hover {
      background-size: 100% 2px;
      transition: background-size 0.3s;
    }
  }

  .nav-item-hover-border-variant {
    background-image: linear-gradient(to bottom, transparent 20%, #fff 21%);
    background-position: 50% 1.3rem;
    background-size: 100% 2px;
    background-repeat: no-repeat;
    transition: background-size 0.3s;
    padding-bottom: 5px;

    &:hover {
      background-size: 0 2px;
    }
  }
</style>
